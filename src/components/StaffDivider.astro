---
interface Props {
  color?: string;
  note?: boolean;
  notePosition?: number; // 0-100, horizontal % position of the note head
}

const { color = "var(--brass)", note = false, notePosition = 50 } = Astro.props;
---

<div class="staff" role="presentation" aria-hidden="true">
  <svg viewBox="0 0 1000 40" preserveAspectRatio="none">
    {[6, 14, 20, 26, 34].map((y) => (
      <line x1="0" y1={y} x2="1000" y2={y} stroke={color} stroke-width="1" />
    ))}
    {note && (
      <ellipse cx={notePosition * 10} cy="20" rx="7" ry="5.5" fill={color} />
    )}
  </svg>
</div>

<style define:vars={{ color }}>
  .staff {
    width: 100%;
    line-height: 0;
    opacity: 0.55;
  }
  svg {
    width: 100%;
    height: 24px;
    display: block;
  }
</style>
