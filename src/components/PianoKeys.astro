---
interface Props {
  variant?: "divider" | "hero";
  highlightIndex?: number; // which white key glows baby-blue
}

const { variant = "divider", highlightIndex = 8 } = Astro.props;

// Two octaves, 14 white keys. Black keys sit to the right of these white-key indices.
const blackKeyAfter = [0, 1, 3, 4, 5, 7, 8, 10, 11, 12];
const whiteKeys = Array.from({ length: 14 }, (_, i) => i);

const height = variant === "hero" ? 150 : 34;
const width = whiteKeys.length * 40;
const whiteW = 40;
const blackW = 24;
const blackH = height * 0.62;
---

<div class:list={["keys", variant]} role="presentation" aria-hidden="true">
  <svg viewBox={`0 0 ${width} ${height}`} preserveAspectRatio="none">
    {whiteKeys.map((i) => (
      <rect
        x={i * whiteW}
        y="0"
        width={whiteW}
        height={height}
        fill={i === highlightIndex && variant === "hero" ? "var(--baby-blue)" : "var(--white)"}
        stroke="var(--black)"
        stroke-width="1"
      />
    ))}
    {blackKeyAfter.map((i) => (
      <rect
        x={(i + 1) * whiteW - blackW / 2}
        y="0"
        width={blackW}
        height={blackH}
        fill="var(--black)"
      />
    ))}
  </svg>
</div>

<style>
  .keys {
    width: 100%;
    line-height: 0;
  }
  .keys svg {
    width: 100%;
    display: block;
  }
  .keys.divider svg {
    height: 16px;
  }
  .keys.hero svg {
    height: clamp(70px, 14vw, 130px);
    filter: drop-shadow(0 10px 24px rgba(20, 23, 26, 0.18));
  }
</style>
