
---
import Layout from "../layouts/Layout.astro";
import PianoKeys from "../components/PianoKeys.astro";

const principles = [
  {
    title: "MUZYKA",
    body: "Bo wszystko zaczyna się od dźwięku. Muzyka buduje emocje, pozwala wyrażać siebie i odkrywać coś nowego. Uczysz się grać utwory, które naprawdę kochasz — i zaczynasz tworzyć własną muzyczną historię.",
  },
  {
    title: "ROZWÓJ",
    body: "Bo każda nowa umiejętność rozwija coś więcej. Pianino uczy koncentracji, pamięci, koordynacji, cierpliwości i systematyczności. Daje Ci przestrzeń, żeby zwolnić, skupić się i zobaczyć własny progres",
  },
  {
    title: "RELACJE",
    body: "Bo pasja łączy ludzi. Claire Atelier to będzie także miejsce spotkań. Kameralne zajęcia, koncerty, warsztaty i wydarzenia, podczas których możesz poznawać ludzi, dzielić się muzyką i tworzyć wspólne wspomnienia.",
  },
];

const pakietsPricingDetails = [
  {
    title: "SOLO",
    pricing: {
      count: "4 zajęcia",
      time: "5 tygodni",
      total: "600 zł",
      perSession: "150 zł",
    },
  },
];

const plans = [
  {
    name: "SOLO",
    length: "60 min",
    price: "99 zł",
    oldPrice: "150 zł",
    detail: "Ty, pianino i pełna uwaga prowadzącego. Indywidualne tempo, program dopasowany do Ciebie i przestrzeń na własny rozwój.",
    highlight: true,
  },
  {
    name: "DUO",
    length: "60 min",
    price: "89 zł / osoba",
    detail: "Nowa pasja, którą możesz dzielić z kimś bliskim. Przyjdź z drugą połówką, przyjacielem, kimś z rodziny czy znajomym.",
    highlight: false,
  },
  {
    name: "GRUPA",
    length: "60 min",
    price: "79 zł / osoba",
    detail: "Muzyka, rozwój i nowe relacje. Kameralne grupy 3–4 osób, wspólna nauka i dobra atmosfera. 100 zł / osoba / zajęcia. Grupy tworzone przy zebraniu odpowiedniej liczby osób.",
    highlight: false,
  },
];

// Replace with your real address — the embed and the directions link both read from this.
const address = "aleja Grunwaldzka 212/2 Gdańsk";
const mapEmbedSrc = `https://www.google.com/maps?q=${encodeURIComponent(address)}&output=embed`;
const directionsHref = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(address)}`;
---

<Layout>
  <header class="nav">
    <a class="wordmark" href="#top">
      <span class="key-mark" aria-hidden="true"></span>
      Cadence
    </a>
    <nav aria-label="Primary">
      <a href="#pillars">Filary</a>
      <a href="#packages">Pakiety</a>
      <a href="#location">Znajdź nas</a>
      <a href="#pricing">Pricing</a>
    </nav>
    <a class="cta-small" href="#pricing">Book a trial lesson</a>
  </header>

  <main id="top">
    <!-- HERO -->
    <section class="hero">
      <div class="hero-logo">
        <img src="../../public/claire_atelier_kolo_jednolity_sifonn.png" alt="Claire Atelier logo" />
      </div>
      <p class="eyebrow">Muzyka · Rozwój · Relacje</p>
      <h1>
        Claire Atelier<br />
        <em>Piano Studio</em>
      </h1>
      <p class="hero-sub">
        <i>Tu nie tylko uczysz się grać. <br />
        Tu rozwijasz siebie i tworzysz relacje.</i><br /><br />
        Kameralne studio pianina w Gdańsku dla osób, które chcą znaleźć nową pasję, rozwijać się i spędzać czas w dobrym towarzystwie.
      </p>
      <div class="hero-actions">
        <a class="cta-primary" href="#pricing">UMÓW PIERWSZE ZAJĘCIA</a>
      </div>
      <p class="meta-line">Grunwaldzka 212/2, Gdańsk</p>
    </section>

    <!-- PILLARS -->
    <section id="pillars" class="section section--mist">
      <h2>TRZY FILARY. JEDNO MIEJSCE.</h2>
      <p class="section-sub">
        Trzy filary. Jedno miejsce. <br />
        W Claire Atelier nie chodzi tylko o naukę gry na pianinie.
        Chodzi o to, co muzyka może zrobić z Twoim czasem, głową i relacjami z innymi.
        To miejsce powstało wokół trzech wartości.
      </p>
      <div class="principles">
        {principles.map((p) => (
          <div class="principle">
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- PRICING -->
    <section id="pricing" class="section section--white">
      <h2>OFERTA NA START</h2>
      <p class="section-sub">Z OKAZJI OTWARCIA CLAIRE ATELIER</p>
      <p class="section-sub">
        Zacznij od pierwszych zajęć. 🎹<br />
        Nie musisz umieć grać. <br />
        Nie musisz znać nut. <br />
        Nie musisz mieć własnego pianina. <br />
        Wystarczy, że chcesz spróbować.
      </p>
      <div class="plans">
        {plans.map((plan) => (
          <div class={`plan ${plan.highlight ? "plan--highlight" : ""}`}>
            <p class="plan-length">{plan.length}</p>
            <h3>{plan.name}</h3>
            <p class="plan-price">
              {plan.price}
              {plan.oldPrice && <s class="plan-price-old">{plan.oldPrice}</s>}
            </p>
            <p class="plan-detail">{plan.detail}</p>
            <a class={plan.highlight ? "cta-primary" : "cta-ghost"} href="#location">
              Zarezerwuj pierwsze zajęcia
            </a>
          </div>
        ))}
      </div>
      <p class="offer-note">
        Oferta na start dotyczy Twoich pierwszych zajęć — ważna do <strong>15 września 2026</strong>.
      </p>
    </section>

    <!-- WHY PACKAGES -->
    <section class="section section--band">
      <h2>A JEŚLI CI SIĘ SPODOBA</h2>
      <p class="band-sub">
        Jeśli poczujesz, że pianino to coś dla Ciebie, możesz wybrać swój sposób nauki i pakiet dopasowany do Twojego rytmu. <br />
        4, 8 lub 12 zajęć. <br />
        Możesz zacząć spokojnie.<br />
        Możesz złapać regularność.<br />
        Możesz wejść w swoją nową pasję na dobre.<br />
        Im więcej grasz, tym więcej zyskujesz.
      </p>
    </section>

    <!-- PACKAGES -->
    <section id="packages" class="section section--mist">
      <h2>WYBIERZ SWÓJ PAKIET</h2>
      <div class="principles">
        {pakietsPricingDetails.map((p) => (
          <div class="principle">
            <p class="section-sub">{p.title}</p>
            <p>{p.pricing.count}</p>
            <p>{p.pricing.time}</p>
            <p>{p.pricing.total}</p>
            <p>{p.pricing.perSession} / zajęcia</p>
          </div>
        ))}
      </div>
    </section>

    <!-- PRACTICE -->
    <section id="practice" class="section section--band">
      <h2>CLAIRE PRACTICE</h2>
      <p class="section-sub">
        <b>Nie masz pianina w domu? To nie problem.</b> <br /><br />
        Twoja pasja nie musi kończyć się wraz z zajęciami. <br /><br />
        Jako członek Claire Atelier możesz korzystać z Claire Practice — kameralnej przestrzeni, w której możesz spokojnie ćwiczyć między zajęciami, przygotować się do kolejnych zajęć albo po prostu usiąść przy pianinie i pograć dla siebie.
      </p>
    </section>

    <!-- LOCATION / MAP -->
    <section id="location" class="section section--black">
      <h2>Znajdź nas</h2>
      <p class="section-sub">Ten minutes from the city center, easy street parking.</p>
      <div class="location-layout">
        <div class="location-info">
          <dl>
            <dt>Address</dt>
            <dd>{address}</dd>
            <dt>Hours</dt>
            <dd>Mon–Fri 10:00–20:00<br />Sat 10:00–15:00</dd>
            <dt>Phone</dt>
            <dd>+48 61 000 00 00</dd>
          </dl>
          <a class="cta-primary" href={directionsHref} target="_blank" rel="noopener noreferrer">
            Get directions
          </a>
        </div>
        <div class="location-map">
          <iframe
            title="Cadence Piano School location"
            src={mapEmbedSrc}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section id="contact" class="section section--band">
      <PianoKeys variant="divider" />
      <h2>Ready to start?</h2>
      <p class="band-sub">
        Tell us the student's age and where they're starting from — we'll
        match them with a teacher and get the first lesson on the calendar
        this week.
      </p>
      <a class="cta-dark" href="mailto:hello@cadencepianoschool.example">
        hello@cadencepianoschool.example
      </a>
      <PianoKeys variant="divider" />
    </section>
  </main>

  <footer class="footer">
    <div class="footer-row">
      <span class="wordmark small">
        <span class="key-mark" aria-hidden="true"></span>
        Cadence
      </span>
      <p>{address} · Mon–Fri 10:00–20:00, Sat 10:00–15:00</p>
    </div>
    <p class="footer-fine">© 2026 Cadence Piano School. Every student gets a free trial lesson.</p>
  </footer>
</Layout>

<style>
  /* ---------- NAV ---------- */
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.1rem clamp(1.25rem, 4vw, 3rem);
    background: var(--white);
    border-bottom: 2px solid var(--baby-blue);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--black);
    text-decoration: none;
    letter-spacing: 0.01em;
  }

  .wordmark.small {
    font-size: 1.05rem;
    color: var(--white);
  }

  .key-mark {
    width: 12px;
    height: 16px;
    background: var(--black);
    border-radius: 0 0 2px 2px;
    display: inline-block;
    flex-shrink: 0;
    position: relative;
  }

  .key-mark::after {
    content: "";
    position: absolute;
    top: 0;
    right: -3px;
    width: 5px;
    height: 9px;
    background: var(--baby-blue-deep);
    border-radius: 0 0 1px 1px;
  }

  .nav nav {
    display: flex;
    gap: clamp(1rem, 2.5vw, 2.25rem);
  }

  .nav nav a {
    color: var(--ink);
    text-decoration: none;
    font-size: 0.92rem;
    opacity: 0.75;
    transition: opacity 0.15s ease;
  }

  .nav nav a:hover {
    opacity: 1;
  }

  @media (max-width: 760px) {
    .nav nav {
      display: none;
    }
  }

  .cta-small {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--black);
    background: var(--baby-blue);
    padding: 0.55rem 0.95rem;
    border-radius: 3px;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s ease;
  }

  .cta-small:hover {
    background: var(--baby-blue-deep);
  }

  /* ---------- HERO ---------- */
  .hero {
    background: var(--white);
    color: var(--ink);
    padding: clamp(3rem, 8vw, 5.5rem) clamp(1.25rem, 6vw, 3rem) 0;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-logo {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1.5px solid var(--baby-blue-deep);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.5rem;
  }

  .hero-logo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--baby-blue-deep);
    margin-bottom: 0.5rem;
  }

  .hero h1 {
    font-size: clamp(2.4rem, 6.5vw, 4.4rem);
    font-weight: 500;
    color: var(--black);
  }

  .hero h1 em {
    color: var(--baby-blue-deep);
    font-style: italic;
    font-weight: 500;
  }

  .hero-sub {
    max-width: 46ch;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.55;
    color: var(--ink-soft);
    margin-top: 0.5rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.9rem;
    margin-top: 1.5rem;
  }

  .cta-primary {
    background: var(--black);
    color: var(--white);
    font-weight: 600;
    text-decoration: none;
    padding: 0.85rem 1.6rem;
    border-radius: 4px;
    font-size: 0.98rem;
    transition: background 0.15s ease, transform 0.15s ease;
    display: inline-block;
  }

  .cta-primary:hover {
    background: var(--black-soft);
    transform: translateY(-1px);
  }

  .cta-ghost {
    border: 1.5px solid var(--black);
    color: var(--black);
    text-decoration: none;
    padding: 0.83rem 1.6rem;
    border-radius: 4px;
    font-size: 0.98rem;
    transition: border-color 0.15s ease, background 0.15s ease;
    display: inline-block;
  }

  .cta-ghost:hover {
    border-color: var(--baby-blue-deep);
    background: var(--mist);
  }

  .cta-dark {
    background: var(--black);
    color: var(--white);
    font-weight: 600;
    text-decoration: none;
    padding: 0.85rem 1.6rem;
    border-radius: 4px;
    font-size: 0.98rem;
    display: inline-block;
    transition: transform 0.15s ease;
  }

  .cta-dark:hover {
    transform: translateY(-1px);
  }

  .hero :global(.keys.hero) {
    margin-top: 2.5rem;
    max-width: 640px;
    width: 100%;
  }

  .meta-line {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-soft);
    padding: 1.25rem 0 2.5rem;
    letter-spacing: 0.02em;
  }

  /* ---------- SECTIONS (shared) ---------- */
  .section {
    padding: clamp(3rem, 7vw, 5.5rem) clamp(1.25rem, 6vw, 3rem);
    text-align: center;
  }

  .section--black {
    background: var(--black);
    color: var(--white);
  }

  .section--white {
    background: var(--white);
    color: var(--ink);
  }

  .section--mist {
    background: var(--mist);
    color: var(--ink);
  }

  .section h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 500;
    text-align: center;
  }

  .section-sub {
    text-align: center;
    max-width: 50ch;
    margin: 0.75rem auto 0;
    opacity: 0.7;
    font-size: 1rem;
  }

  /* ---------- OFFER NOTE ---------- */
  .offer-note {
    text-align: center;
    max-width: 50ch;
    margin: 2.5rem auto 0;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--black) 10%, transparent);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.01em;
    color: var(--ink-soft);
  }

  .offer-note strong {
    color: var(--baby-blue-deep);
    font-weight: 600;
  }

  /* ---------- PRINCIPLES / PACKAGES ---------- */
  .principles {
    max-width: 1000px;
    margin: 2.5rem auto 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    text-align: center;
  }

  .principle h3 {
    font-size: 1.2rem;
    font-weight: 500;
    margin-bottom: 0.6rem;
    color: var(--black);
  }

  .principle p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  @media (max-width: 780px) {
    .principles {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }

  /* ---------- PRICING ---------- */
  .plans {
    max-width: 1000px;
    margin: 2.5rem auto 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: stretch;
    text-align: center;
  }

  .plan {
    background: var(--white);
    border: 1.5px solid color-mix(in srgb, var(--black) 14%, transparent);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    border-radius: 6px;
  }

  .plan--highlight {
    background: var(--black);
    color: var(--white);
    border-color: var(--black);
  }

  .plan-length {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    opacity: 0.6;
  }

  .plan h3 {
    font-size: 1.35rem;
    font-weight: 500;
    margin: 0.15rem 0 0.1rem;
  }

  .plan-price {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    color: var(--baby-blue-deep);
    margin-bottom: 0.4rem;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .plan-price-old {
    font-size: 0.8rem;
    opacity: 0.5;
    text-decoration: line-through;
  }

  .plan--highlight .plan-price {
    color: var(--baby-blue);
  }

  .plan-detail {
    font-size: 0.9rem;
    line-height: 1.55;
    opacity: 0.85;
    flex-grow: 1;
    margin-bottom: 1.25rem;
  }

  .plan .cta-primary,
  .plan .cta-ghost {
    text-align: center;
    padding: 0.7rem 1rem;
    font-size: 0.9rem;
  }

  .plan--highlight .cta-primary {
    background: var(--baby-blue);
    color: var(--black);
  }

  .plan--highlight .cta-primary:hover {
    background: var(--baby-blue-deep);
  }

  @media (max-width: 780px) {
    .plans {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- LOCATION / MAP ---------- */
  .location-layout {
    max-width: 1080px;
    margin: 2.5rem auto 0;
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 2.5rem;
    align-items: start;
    text-align: left;
  }

  .location-info {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .location-info dl {
    margin: 0;
    display: grid;
    row-gap: 0.9rem;
  }

  .location-info dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--baby-blue);
    margin-bottom: 0.15rem;
  }

  .location-info dd {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--white) 88%, transparent);
  }

  .location-info .cta-primary {
    background: var(--baby-blue);
    color: var(--black);
    width: fit-content;
  }

  .location-info .cta-primary:hover {
    background: var(--baby-blue-deep);
  }

  .location-map {
    border: 2px solid var(--baby-blue);
    border-radius: 6px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .location-map iframe {
    width: 100%;
    height: 100%;
    border: 0;
    filter: grayscale(0.15) contrast(1.02);
  }

  @media (max-width: 820px) {
    .location-layout {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- FINAL CTA BAND ---------- */
  .section--band {
    background: var(--baby-blue);
    color: var(--black);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .section--band :global(.keys.divider) {
    max-width: 480px;
    width: 100%;
  }

  .section--band h2 {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
  }

  .band-sub {
    max-width: 46ch;
    opacity: 0.85;
    line-height: 1.6;
    margin: 0 auto;
  }

  /* ---------- FOOTER ---------- */
  .footer {
    background: var(--black);
    color: color-mix(in srgb, var(--white) 65%, transparent);
    padding: 2rem clamp(1.25rem, 6vw, 3rem);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-row p {
    font-size: 0.85rem;
  }

  .footer-fine {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    opacity: 0.55;
  }
</style>
